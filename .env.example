# Copy to .env.local in each app (or repo root for scripts). Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=your-resend-key
# Shared secret for the notification cron route (apps/va /api/notifications/process)
CRON_SECRET=generate-a-long-random-string
NOTIFICATIONS_FROM=Vabrato <notifications@vabrato.com>

# MLSListings (packages/mls). Keep MLS_MODE=mock until credentials arrive.
MLS_MODE=mock
MLS_OFFICE_ID=VABRA
MLS_API_BASE_URL=
MLS_TOKEN_URL=
MLS_CLIENT_ID=
MLS_CLIENT_SECRET=
MLS_RATE_LIMIT_PER_SEC=2
# hotlink | copy (copy only once MLSListings allows storing photos)
MLS_PHOTO_MODE=hotlink
# 3 or 5, pending MLSListings
MLS_SOLD_HISTORY_YEARS=3
# Sync job only (Render): Supabase Postgres connection string for the mls_sync role
DATABASE_URL=
# Sync job, MLS_PHOTO_MODE=copy only
SUPABASE_URL=

# apps/web public site (S4)
NEXT_PUBLIC_SITE_URL=https://vabrato.com
# Mapbox public token, URL-restricted to our domains. Unset: search is list-only.
NEXT_PUBLIC_MAPBOX_TOKEN=
# Agent console URL, linked from /my and the Staff sign-in links (S5).
NEXT_PUBLIC_CONSOLE_URL=https://console.vabrato.com
# Cloudflare Turnstile for public forms and join / sign-in. Unset: Turnstile is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Salt for hashing client IPs on leads (per-IP limit). Unset: no IP limit.
LEAD_IP_SALT=generate-a-long-random-string
# Listing view counts for the seller portal (/api/listing-view). Its sha256 must
# also be in public.listing_view_keys (docs/STATUS.md). Unset: no views counted.
LISTING_VIEW_SECRET=generate-a-long-random-string
# Shared secret for /api/revalidate (the MLS sync job sends it as MLS_REVALIDATE_SECRET).
REVALIDATE_SECRET=generate-a-long-random-string
MLS_REVALIDATE_URL=
MLS_REVALIDATE_SECRET=
# Member alerts after each sync (Render job, S5). See packages/mls/RENDER.md.
ALERTS_ENABLED=
NOTIFICATIONS_PROCESS_URL=
NOTIFICATIONS_CRON_SECRET=
# apps/va: public site origin for links in alert emails and open-house sign-in links (default https://vabrato.com).
PUBLIC_SITE_URL=https://vabrato.com
