# Copy to .env.local in each app (or repo root for scripts). Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=your-resend-key
# Shared secret for the notification cron route (apps/va /api/notifications/process)
CRON_SECRET=generate-a-long-random-string
NOTIFICATIONS_FROM=Vabrato <notifications@vabrato.com>
